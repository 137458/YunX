    <!-- Onboarding (local wording) -->
    <string name="rs_onboarding_feature_link_title">Parse share links instantly</string>
    <string name="rs_onboarding_feature_link_desc">Detects share links from 10 drives including Quark, UC, Xunlei, Baidu, 139, 123, 115, GuangYa and Lanzou; sign in to browse and download</string>
    <string name="rs_onboarding_feature_video_desc">Douyin, Xiaohongshu, Kuaishou, Weibo and AcFun need no sign-in; Bilibili offers higher quality after sign-in. Links from 7 major video platforms resolve to direct URLs, and images, videos and audio can be previewed online</string>
    <string name="rs_onboarding_feature_multi_title">Multi-platform</string>
    <string name="rs_onboarding_feature_multi_desc">Manage multiple drive accounts in one app with a single parse-and-download entry</string>
    <string name="rs_onboarding_feature_privacy_title">Privacy and security</string>
    <string name="rs_onboarding_feature_privacy_desc">Credentials stay on this device and are never uploaded</string>
    <string name="rs_onboarding_free_hint">No ads, no in-app purchases — all features are free forever</string>
    <string name="rs_onboarding_disclaimer">Disclaimer: this app is for personal study and technical exchange only; do not use it commercially. Downloaded content remains the copyright of its authors — delete it within 24 hours. You are solely responsible for any consequences of using this app.</string>

